# Copy this file to battery-limiter.env before deployment if you need overrides.
# The deploy script uploads battery-limiter.env to /etc/default/battery-limiter when present.
# These are examples for OnePlus 6 / Mobian, not universal charger settings.
# current_max is an input-current limit in microamps, not battery current_now.

CAP_LOW=40
CAP_HIGH=80
TEMP_LOCK_ENTER=450
TEMP_LOCK_EXIT=400
TICK_INTERVAL=300
RETRY_INTERVAL=10
TUNING_SETTLE=30
CURRENT_OFF=0
# OnePlus 6 profile: 0.6 A helped avoid Charging/Discharging oscillation under
# the author's server workload. The script's generic starting default is 0.5 A.
# This is a reproducible example, not a live export or a universal minimum.
CURRENT_START=600000
CURRENT_STEP=100000
CURRENT_CEIL=1000000
# Driver-specific maximum; verify its meaning before using another device.
CURRENT_DRIVER=4800000
RECOVERY_OFF_DWELL=3
RECOVERY_PRIME=1000000
RECOVERY_PRIME_SETTLE=15
RECOVERY_BOOST_SETTLE=12
# RECOVERY_BOOST defaults to CURRENT_DRIVER unless you need a separate boost value.
# STOP_CURRENT_MAX defaults to CURRENT_DRIVER unless you need a different restore value on service stop.
# Stopping the service restores that limit; it does not stop charging.

# --- Wake-up escalation when the charger IC latches into "Not charging" ---
# Starting at ESCALATE_REBIND_AT the limiter unbinds / rebinds the charger
# driver before each ladder cycle. Raise the number to be gentler, lower it
# to escalate faster. On sdm845 / PMI8998 rebind is only reliable when the
# kernel has the DKMS driver fix installed (see kernel-patch/README.md).
# Parent-PMIC rebind changes device state; the patch also disables hardware
# charge safety timers. Read its limitations before installing or enabling it.
# ESCALATE_REBIND_AT=2         # cycle at which driver unbind/rebind starts
# REBIND_OFF_DWELL=3           # seconds between unbind and bind
# REBIND_SETTLE=15             # max seconds to wait for current_max to reappear

# Leave these unset to auto-detect the first power_supply node that exposes
# capacity, temp, status, and current_now in one place.
# BATTERY_GAUGE_BASE_PATH=/sys/class/power_supply/your-battery
# SYS_CAP=/sys/class/power_supply/your-battery/capacity
# SYS_TEMP=/sys/class/power_supply/your-battery/temp
# SYS_BQST=/sys/class/power_supply/your-battery/status
# SYS_CUR=/sys/class/power_supply/your-battery/current_now
# Leave these unset to auto-detect the first /sys/class/power_supply/*/current_max node.
# SYS_CMAX=/sys/class/power_supply/your-charger/current_max
# CHARGER_CURRENT_MAX_PATH=/sys/class/power_supply/your-charger/current_max
